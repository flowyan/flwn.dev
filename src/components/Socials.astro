---
interface Social {
  title: string;
  bgColor: string;
  link: string;
}

const socials: Social[] = [
  {
    title: "bluesky",
    bgColor: "#1185FE",
    link: "https://bsky.app/profile/flwn.dev",
  },
  {
    title: "github",
    bgColor: "#232925",
    link: "https://github.com/flowyan",
  },
  {
    title: "modrinth",
    bgColor: "#00AF5C",
    link: "https://modrinth.com/user/Flowyan",
  },
];
---

<div class="adBoard">
  {socials.map((ad) => (
    <a
      href={ad.link}
      target="_blank"
      rel="noopener noreferrer"
      style={`background-color: ${ad.bgColor};`}
      data-color={ad.bgColor}
    >
      {ad.title}
    </a>
  ))}
</div>

<style>
  .adBoard {
    width: 100%;
    height: 50px;
    display: flex;
    gap: 0.5rem;

    background: linear-gradient(
      to bottom right,
      var(--module-background),
      var(--module-background-darker)
    );
  }

  .adBoard a {
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: bold;
    text-shadow: 0 0 15px var(--primary);
    border: 3px solid var(--module-border);
    transition: all 0.3s;
    width: 100%;
    height: 100%;

    &:hover {
      transition: all 0.3s;
      background: linear-gradient(
        to bottom right,
        var(--module-background-darker),
        var(--module-background-hover)
      );
      border-color: var(--module-border-hover);
  }
</style>
