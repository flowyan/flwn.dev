---
import auroraNerd from "../assets/auroranerd.webp";
import flwnPic from "../assets/flwn.png";
import BlogItem from "./BlogItem.astro";
import ModuleBar from "./ModuleBar.astro";
---

<div class="blogsModuleContainer">
  <ModuleBar
    title="latest blog posts"
    titleDescription="here are my latest blog posts where i yap"
    icon={auroraNerd.src}
    iconDescription="omg hi aurora ><"
  />
  <div class="module">
    <BlogItem title="my third blog post" imageUrl={flwnPic.src} />
    <BlogItem title="my second blog post" imageUrl={flwnPic.src} />
    <BlogItem title="my first blog post" imageUrl={flwnPic.src} />
    <BlogItem title="my first blog post" imageUrl={flwnPic.src} />
  </div>
</div>

<style>
  .blogsModuleContainer {
    width: 100%;
    height: 100%;
    max-height: 256px;

    overflow-x: scroll;

    display: flex;
    flex-direction: column;

    backdrop-filter: blur(10px);

    .module {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      overflow-x: hidden;
      overflow-y: scroll;

      background: linear-gradient(
        to bottom right,
        var(--module-background),
        var(--module-background-darker)
      );
      padding: 0.5rem;
      border: 3px solid var(--module-border);

      transition: all 0.3s;

      &:hover {
        transition: all 0.3s;
        background: linear-gradient(
          to bottom right,
          var(--module-background-darker),
          var(--module-background-hover)
        );
        border-color: var(--module-border-hover);
      }
    }
  }
</style>
