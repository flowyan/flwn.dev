---
import ModuleBar from "./ModuleBar.astro";

interface Props {
  title: string;
  titleDescription?: string;
  icon?: string;
  iconDescription?: string;
}

const { title, titleDescription, icon, iconDescription } = Astro.props;
---

<div class="moduleContainer">
  <ModuleBar
    title={title}
    titleDescription={titleDescription}
    icon={icon}
    iconDescription={iconDescription}
  />
  <div class="module">
    <slot />
  </div>
</div>

<style>
  .moduleContainer {
    width: 100%;
    max-width: 1024px;
    height: 100%;

    display: flex;
    flex-direction: column;

    backdrop-filter: blur(10px);
  }

  .module {
    flex: 1;

    background: linear-gradient(
      to bottom right,
      var(--module-background),
      var(--module-background-darker)
    );
    padding: 0.5rem;
    border: 3px solid var(--module-border);

    transition: all 0.3s;

    &:hover {
      transition: all 0.3s;
      background: linear-gradient(
        to bottom right,
        var(--module-background-darker),
        var(--module-background-hover)
      );
      border-color: var(--module-border-hover);
    }
  }
</style>
