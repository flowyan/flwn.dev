---
//TODO: Add periodic fetching for the api to keep up to date
//TODO: Add more dancers and a randomizer for them with button to change them

import musicjak from "../assets/musicjak.png";
import ModuleBar from "./ModuleBar.astro";
import { Dancer } from "./Dancer/Dancer";

const lastFmApi = await fetch("https://api.flwn.dev/lastfm").then((res) =>
  res.json(),
);

const imageUrl = lastFmApi.recenttracks.track[0].image[2]["#text"];

const nowPlaying =
  lastFmApi.recenttracks.track[0]["@attr"]?.nowplaying === "true";
---

<div class="lastFmModuleContainer">
  <ModuleBar
    title={nowPlaying ? "listening to" : "last listened to"}
    titleDescription="the music i'm listening/listened to"
    icon={musicjak.src}
    iconDescription="look at him go"
  />
  <div class="lastFmModule">
    <div class="flex flex-row gap-2 items-center p-2">
      <a
        href={lastFmApi.recenttracks.track[0].url}
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          class="coverArt"
          src={imageUrl ?? musicjak.src}
          alt="Album Art"
          title="Album Art"
        />
      </a>
      <div class="flex flex-col gap-1 truncate">
        <p title="Track Title">{lastFmApi.recenttracks.track[0].name}</p>
        <p title="Artist Name">
          {lastFmApi.recenttracks.track[0].artist["#text"]}
        </p>
        <p title="Album Title">
          {lastFmApi.recenttracks.track[0].album["#text"]}
        </p>
      </div>
    </div>
    <Dancer
      client:load
      nowPlaying={nowPlaying}
      scrobbleCount={lastFmApi.recenttracks["@attr"].total}
    />
  </div>
</div>

<style>
  .lastFmModuleContainer {
    width: 400px;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0;
    flex-shrink: 0;

    backdrop-filter: blur(10px);

    .lastFmModule {
      display: flex;
      flex-direction: column;
      flex-grow: 1;

      background: linear-gradient(
        to bottom right,
        var(--module-background),
        var(--module-background-darker)
      );
      border: 3px solid var(--module-border);

      transition: all 0.3s;

      &:hover {
        transition: all 0.3s;
        background: linear-gradient(
          to bottom right,
          var(--module-background-darker),
          var(--module-background-hover)
        );
        border-color: var(--module-border-hover);

        .dancer {
          border-top: 3px solid var(--module-border-hover);
        }
      }

      .coverArt {
        background-color: var(--primary-background);
        background: url("/img/musicjak.png");
        background-size: cover;
        height: 100px;
        width: 100px;
        max-width: 100px;
        min-width: 100px;
        object-fit: cover;
        border: 2px solid var(--secondary);
        box-shadow: 0 0 5px var(--primary-background);
        transition: all 0.1s ease-in-out;

        &:hover {
          transition: all 0.1s ease-in-out;
          transform: scale(1.01);
        }
      }
    }
  }
</style>
