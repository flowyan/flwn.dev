---
interface Ad {
  title: string;
  imageUrl: string;
  link: string;
}

const ads: Ad[] = [
  {
    title: "cat.basil.florist",
    imageUrl: "/img/fakeads/catbasilflorist.png",
    link: "https://cat.basil.florist",
  },
  {
    title: "cat.basil.florist",
    imageUrl: "/img/fakeads/catbasilflorist.png",
    link: "https://cat.basil.florist",
  },
