---
import Layout from "../layouts/Layout.astro";

import Module from "../components/Module.astro";
import LastFmModule from "../components/LastFmModule.astro";
import ClickableFlwn from "../components/ClickableFlwn.astro";

import tequilaPic from "../assets/tequila.jpg";
import fatass from "../assets/tetofatass.jpg";
import AdBoard from "../components/AdBoard.astro";
import BlogsModule from "../components/BlogsModule.astro";
---

<Layout>
  <div class="modulesContainer flex flex-col gap-4 items-center h-full">
    <Module
      title="welcome"
      titleDescription="welcome to my website!"
      icon={tequilaPic.src}
      iconDescription="my (grandma's) awesome fucking cat"
    >
      <div class="flex flex-row gap-4">
        <span>
          <ClickableFlwn />
        </span>
        <div class="flex flex-col gap-2 justify-between">
          <p>Hi, I'm Flowyan and this is my website.</p>
          <p>
            I'm a software developer that loves to code silly things and do web
            development for work.
            <br />I love coding in C# but was taught Java in high school and
            that's mainly how I got into programming. I know C#, Java/Kotlin,
            JavaScript/TypeScript and for web development I use React and
            Next.js mostly because of my job.
          </p>
          <p>tl;dr welcome to my silly little website and im epic</p>
        </div>
      </div>
    </Module>
    <div class="flex flex-col gap-4 w-full">
      <div class="flex gap-4 justify-center">
        <BlogsModule />
        <LastFmModule />
      </div>
      <AdBoard />
    </div>

    <Module
      title="projects"
      titleDescription="the projects that i am proud of"
      icon={fatass.src}
      iconDescription="fat ass"
    >
      soon
    </Module>
  </div>
</Layout>

<style>
  .modulesContainer {
    max-width: 1024px;
  }
</style>
